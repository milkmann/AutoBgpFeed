# ==========================================
# Auto BGP Feed v2 - Environment Configuration
# ==========================================

# Public IP or Domain of this server (used for BIRD router-id & router config hints)
SERVER_IP=YOUR_SERVER_IP

# BGP Autonomous System Number (ASN) of this server
SERVER_ASN=65000

# External BGP TCP Port (Default is 179)
BGP_PORT=179

# Web Dashboard Bind Address & Port (use 127.0.0.1 behind Cloudflare Tunnel / reverse proxy)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Initial Admin Credentials (only used on first launch when DB users table is empty)
ADMIN_USER=admin
ADMIN_PASS=

# HMAC secret for signing session cookies (leave empty to auto-generate in /data/.session_secret)
SESSION_SECRET=

# Broad prefix guard (minimum allowed IPv4 prefix length, e.g. 8 blocks anything wider than /8)
MIN_PREFIX_LENGTH=8

# Source fallback cache lifetime in seconds (default 7 days)
CACHE_MAX_AGE=604800

# Trust X-Forwarded-For / CF-Connecting-IP / X-Forwarded-Proto headers from reverse proxy
TRUST_PROXY_HEADERS=1
