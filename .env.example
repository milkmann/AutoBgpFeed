# ==========================================
# Auto BGP Feed - Environment Configuration
# ==========================================

# Public IP or Domain of this server (used for MikroTik connection hints)
SERVER_IP=YOUR_SERVER_IP

# BGP Autonomous System Number (ASN) of this server
SERVER_ASN=65000

# External BGP TCP Port (Default is 179)
BGP_PORT=179

# Web Dashboard Port
WEB_PORT=8080

# Web Dashboard HTTP Basic Auth Credentials
ADMIN_USER=admin
ADMIN_PASS=changeme_secure_password
